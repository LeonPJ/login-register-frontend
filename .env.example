# 複製成 .env 後再改。位址指到 login-register-backend。
# 後端預設 port 是 3000，和前端開發伺服器相同，請讓其中一個改埠。

REACT_APP_API_LOGIN=http://localhost:3000/user/login
REACT_APP_API_NEW_PASSWORD=http://localhost:3000/user/newpassword
REACT_APP_API_FORGOT_PASSWORD=http://localhost:3000/user/forgotpassword

REACT_APP_API_READ=http://localhost:3000/order/get
REACT_APP_API_CREATE=http://localhost:3000/order/create
# 前端會再接上 /:id
REACT_APP_API_DELETE=http://localhost:3000/order/delete
# 前端會再接上 /:id
REACT_APP_API_UPDATE=http://localhost:3000/order/update
# 前端會再接上 /:type/:value（name、phone 或 address）
REACT_APP_API_SEARCH_NAME_PHONE_ADDRESS=http://localhost:3000/order/get/search
REACT_APP_API_CURRENT_MONTH=http://localhost:3000/order/get/current/month
# 畫面尚未使用。後端為 GET /order/get/current/:year/:month
REACT_APP_API_CURRENT_PERIOD=http://localhost:3000/order/get/current
